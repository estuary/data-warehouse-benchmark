vendor/

# === Estuary substituted catalog specs (regenerated on every publish) ===
estuary/.applied/

# === Jupyter ===
.ipynb_checkpoints/
/data/generators/

# === Agent ===
.claude/projects/*
.claude/settings.local.json
results/estuary_throughput/
!results/exports/*.parquet
