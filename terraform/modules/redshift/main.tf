// Redshift Serverless module: namespace (default DB + admin user), workgroup,
// inbound security group, and an IAM role with read access to the shared S3
// staging bucket. The per-suite, per-scale schemas are created by the Estuary
// materializations, not here.

terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.51"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.9"
    }
  }
}

variable "region" {
  type    = string
  default = "us-east-1"
}

variable "namespace_name" {
  type    = string
  default = "benchmark-2026"
}

variable "workgroup_name" {
  type    = string
  default = "benchmark-wg"
}

variable "database_name" {
  type    = string
  default = "benchmark_db"
}

variable "admin_username" {
  type    = string
  default = "benchmark_admin"
}

variable "admin_password_override" {
  description = "Optional admin password override. Leave empty (default) to use a random_password generated by this module — pull the result from the `admin_password` output and put it in env/redshift.env."
  type        = string
  sensitive   = true
  default     = ""
}

# Random_password's `override_special` excludes the chars Redshift rejects:
#   /  @  "  '  \  <space>
# Redshift Serverless requires 8-64 chars, ≥1 upper, ≥1 lower, ≥1 number.
# 32 chars + the alpha+digit+special mix below meets all four.
resource "random_password" "admin" {
  length           = 32
  upper            = true
  lower            = true
  numeric          = true
  special          = true
  override_special = "!#$%&*+-=?^_{}~"
}

locals {
  admin_password = var.admin_password_override != "" ? var.admin_password_override : random_password.admin.result
}

variable "baseline_rpu" {
  description = "Serverless baseline RPU (8 minimum)."
  type        = number
  default     = 32
}

variable "max_rpu" {
  type    = number
  default = 256
}

variable "staging_bucket_arn" {
  description = "ARN of the shared S3 staging bucket (from terraform/modules/shared)."
  type        = string
}

variable "allowed_inbound_cidrs" {
  description = "CIDR blocks allowed inbound on Redshift port 5439. Defaults to 0.0.0.0/0 for benchmark convenience — password auth is the security boundary. Tighten before production by setting your office/VPN IP ranges."
  type        = list(string)
  default     = ["0.0.0.0/0"]
}

data "aws_vpc" "default" {
  default = true
}

resource "aws_security_group" "redshift" {
  name        = "${var.workgroup_name}-redshift-inbound"
  description = "Inbound TCP/5439 access for the benchmark Redshift workgroup."
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "Redshift SQL"
    from_port   = 5439
    to_port     = 5439
    protocol    = "tcp"
    cidr_blocks = var.allowed_inbound_cidrs
  }

  egress {
    description = "All outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Project = "benchmark-2026"
  }
}

resource "aws_iam_role" "redshift_s3" {
  name = "${var.namespace_name}-s3-read-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "redshift.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      },
    ]
  })
}

resource "aws_iam_role_policy" "redshift_s3" {
  name = "${var.namespace_name}-s3-read"
  role = aws_iam_role.redshift_s3.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "s3:GetObject",
          "s3:ListBucket",
          "s3:GetBucketLocation",
        ]
        Resource = [
          var.staging_bucket_arn,
          "${var.staging_bucket_arn}/*",
        ]
      },
    ]
  })
}

resource "aws_redshiftserverless_namespace" "benchmark" {
  namespace_name      = var.namespace_name
  db_name             = var.database_name
  admin_username      = var.admin_username
  admin_user_password = local.admin_password
  iam_roles           = [aws_iam_role.redshift_s3.arn]
  tags = {
    Project = "benchmark-2026"
  }
}

resource "aws_redshiftserverless_workgroup" "benchmark" {
  namespace_name      = aws_redshiftserverless_namespace.benchmark.namespace_name
  workgroup_name      = var.workgroup_name
  base_capacity       = var.baseline_rpu
  max_capacity        = var.max_rpu
  publicly_accessible = true
  security_group_ids  = [aws_security_group.redshift.id]
}

output "workgroup" {
  value = aws_redshiftserverless_workgroup.benchmark.workgroup_name
}

# Provisioned serverless compute (RPU = Redshift Processing Units). The root
# module passes max_rpu = baseline_rpu, so the workgroup is pinned and does not
# autoscale. The baseline is sized per scale: run_plan.yaml sets the RPU for each
# scale, and `benchmark prepare-scale` writes it to sizing.auto.tfvars.json
# (scripts/resize/redshift_resize.py resizes out of band and syncs that file).
output "baseline_rpu" {
  value = var.baseline_rpu
}

output "max_rpu" {
  value = var.max_rpu
}

output "namespace" {
  value = aws_redshiftserverless_namespace.benchmark.namespace_name
}

output "endpoint_address" {
  value = "${aws_redshiftserverless_workgroup.benchmark.endpoint[0].address}:${aws_redshiftserverless_workgroup.benchmark.endpoint[0].port}"
}

output "iam_role_arn" {
  value = aws_iam_role.redshift_s3.arn
}

output "admin_username" {
  value = var.admin_username
}

output "admin_password" {
  value     = local.admin_password
  sensitive = true
}
