# ======================================================================
# FABRIC (prefix: FABRIC_)
# Microsoft Fabric tenant credentials. Drives the Data Warehouse
# component (the SQL benchmark).
# ======================================================================

# Azure AD tenant ID for the Fabric workspace.
FABRIC_TENANT_ID=

# Service principal app ID with Fabric workspace access.
FABRIC_CLIENT_ID=

# Secret for the service principal.
FABRIC_CLIENT_SECRET=

# Fabric Data Warehouse SQL endpoint.
FABRIC_DW_ENDPOINT=

# Database name on the DW endpoint.
FABRIC_DW_DATABASE=BENCHMARK_DW

# Azure Storage account the materialize-azure-fabric-warehouse connector
# stages Parquet into before COPY INTO.
FABRIC_STAGING_STORAGE_ACCOUNT=

# Account key for STAGING_STORAGE_ACCOUNT (Estuary writes/reads the staging
# container).
FABRIC_STAGING_STORAGE_KEY=

# Container name inside STAGING_STORAGE_ACCOUNT used as the Estuary staging
# area.
FABRIC_STAGING_CONTAINER=

# Provisioned Fabric capacity SKU (f2/f4/f8/f16/f32/f64/f128); drives
# PROPORTIONAL cost attribution.
FABRIC_CAPACITY_SKU=f64

# Azure subscription holding the Fabric capacity — for the ARM lookup that
# validates the running SKU at runtime.
FABRIC_SUBSCRIPTION_ID=

# Resource group of the Fabric capacity (ARM capacity lookup).
FABRIC_RESOURCE_GROUP=

# Fabric capacity resource name (ARM lookup; validates actual SKU vs
# CAPACITY_SKU).
FABRIC_CAPACITY_NAME=
