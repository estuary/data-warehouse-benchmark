# ======================================================================
# CLICKHOUSE (prefix: CLICKHOUSE_)
# ClickHouse Cloud credentials. Single service ('Estuary Benchmark')
# provisioned out-of-band; terraform only records its UUID. HOST and
# PORT come from the service overview in the Cloud UI; PASSWORD must
# be copied from the Cloud UI too (the API doesn't expose it).
# ======================================================================

# Service hostname, from the service overview in the ClickHouse Cloud UI.
CLICKHOUSE_HOST=

# HTTPS port for clickhouse-connect; 8443 secure, 8123 plain.
CLICKHOUSE_PORT=8443

# Username for query traffic; the Cloud-provisioned default user is
# 'default'.
CLICKHOUSE_USER=default

# Password for USER. Copy from the ClickHouse Cloud UI — the API does not
# expose it.
CLICKHOUSE_PASSWORD=

# ClickHouse Cloud organization ID — for the Cloud API call that validates
# the running service size.
CLICKHOUSE_ORG_ID=

# ClickHouse Cloud service ID (Cloud API service lookup).
CLICKHOUSE_SERVICE_ID=

# ClickHouse Cloud API key ID (Basic-auth user for the Cloud API).
CLICKHOUSE_API_KEY_ID=

# ClickHouse Cloud API key secret (Basic-auth password for the Cloud API).
CLICKHOUSE_API_KEY_SECRET=
