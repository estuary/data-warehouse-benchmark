# ======================================================================
# ROOT (prefix: BENCHMARK_)
# Top-level harness settings. Cross-cutting BENCHMARK_* vars (staging
# bucket, optimize-pass API key) plus nested per-engine and shared
# sub-trees. Instantiate once via :func:`get_settings`.
# ======================================================================

# Shared S3 bucket Estuary captures stage Parquet to before materialization.
BENCHMARK_S3_BUCKET=

# Anthropic API key for the optimize pass's `--via sdk` backend.
BENCHMARK_ANTHROPIC_API_KEY=

# Anthropic model id for the per-engine query optimization pass (`benchmark
# optimize`); override if a different model is preferred.
BENCHMARK_OPTIMIZE_MODEL=claude-opus-4-8

# Path to exported `terraform output -json` (written by `benchmark export-
# terraform-outputs`). Read at runtime to record each engine's provisioned
# compute (warehouse size, RPUs, slots, capacity SKU) into
# engine_environment, per scale. Missing/invalid file -> omitted.
BENCHMARK_TERRAFORM_OUTPUTS_PATH=terraform/outputs.json
