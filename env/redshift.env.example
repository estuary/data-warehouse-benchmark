# ======================================================================
# REDSHIFT (prefix: REDSHIFT_)
# Amazon Redshift Serverless workgroup.
# ======================================================================

# Serverless workgroup name; resolved via boto3 when ENDPOINT is blank.
REDSHIFT_WORKGROUP=

# Database name on the workgroup.
REDSHIFT_DATABASE=benchmark_db

# Required for Estuary loads (password-only); optional for the Python
# connector (falls back to IAM).
REDSHIFT_USER=

# Password for USER.
REDSHIFT_PASSWORD=

# Optional explicit endpoint override; otherwise looked up from the
# workgroup.
REDSHIFT_ENDPOINT=
