# ======================================================================
# AWS (prefix: AWS_)
# Shared AWS credentials. Used by Redshift IAM auth (when
# REDSHIFT_PASSWORD is blank) and by `benchmark stage-data` uploads to
# the staging bucket.
# ======================================================================

# AWS region for Redshift Serverless and the S3 staging bucket.
AWS_REGION=us-east-1

# Local AWS credentials profile name (read by boto3).
AWS_PROFILE=benchmark
