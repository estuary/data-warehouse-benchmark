# ======================================================================
# BIGQUERY (prefix: BIGQUERY_)
# BigQuery (Enterprise reservation) project and dataset, plus the
# Estuary GCS staging bucket and the harness service-account key.
# ======================================================================

# GCP project ID hosting the benchmark dataset.
BIGQUERY_PROJECT=

# BigQuery region; pins slot reservation + Estuary staging location.
BIGQUERY_REGION=us-central1

# Dataset holding TPC-DS/DSB/ClickBench tables.
BIGQUERY_DATASET=tpcds

# Path to the harness runner SA JSON (BigQuery jobUser + dataEditor).
BIGQUERY_GCP_SA_KEY=

# GCS bucket the Estuary materialize-bigquery connector stages into.
BIGQUERY_GCS_STAGING_BUCKET=
