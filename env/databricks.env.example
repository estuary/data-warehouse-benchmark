# ======================================================================
# DATABRICKS (prefix: DATABRICKS_)
# Databricks SQL Warehouse (serverless) credentials.
# ======================================================================

# Workspace URL host (e.g. 'adb-1234.5.azuredatabricks.net').
DATABRICKS_HOST=

# Personal access token for the benchmark service principal.
DATABRICKS_TOKEN=

# HTTP path of the SQL warehouse endpoint.
DATABRICKS_SQL_HTTP_PATH=

# HTTP path of the SQL warehouse Estuary's materializations write through;
# unset means the benchmark warehouse (SQL_HTTP_PATH). A separate loader
# keeps a long load off the warehouse being measured.
DATABRICKS_LOADER_SQL_HTTP_PATH=

# Unity Catalog name holding the benchmark tables.
DATABRICKS_CATALOG=benchmark_catalog
