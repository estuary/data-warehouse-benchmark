# ======================================================================
# ESTUARY (prefix: ESTUARY_)
# Estuary Flow control-plane credentials and per-engine connector
# secrets injected into materialization YAML.
# ======================================================================

# flowctl auth token; required to apply captures/materializations.
ESTUARY_REFRESH_TOKEN=

# Estuary account/tenant prefix (e.g. 'CorrDyn'); namespaces collection
# paths.
ESTUARY_ACCOUNT=

# On Windows, the WSL distro flowctl runs in (flowctl ships Linux-only). Must
# be installed (`wsl -l -v`) and have flowctl on PATH.
ESTUARY_WSL_DISTRO=Ubuntu-24.04

# Base URL of Estuary's OpenMetrics API
# (docs.estuary.dev/reference/openmetrics-api); '/{prefix}/' is appended per
# request. Auth is REFRESH_TOKEN as a Bearer header.
ESTUARY_OPENMETRICS_URL=https://api.estuary.dev/api/v1/metrics

# Least-privilege reader key for Estuary captures pulling from the staging
# bucket.
ESTUARY_S3_AWS_ACCESS_KEY_ID=

# Secret half of the Estuary S3 reader credentials.
ESTUARY_S3_AWS_SECRET_ACCESS_KEY=

# Filesystem path to the JSON SA key for the Estuary materialize-bigquery
# connector.
ESTUARY_BIGQUERY_SERVICE_ACCOUNT_KEY=
