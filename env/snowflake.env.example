# ======================================================================
# SNOWFLAKE (prefix: SNOWFLAKE_)
# Snowflake (Gen2 Standard) credentials and warehouse defaults.
# ======================================================================

# Snowflake account identifier (e.g. 'xy12345.us-east-1.aws').
SNOWFLAKE_ACCOUNT=

# Service user the harness + Estuary authenticate as (created by terraform;
# distinct from the admin user terraform itself runs as).
SNOWFLAKE_BENCHMARK_USER=

# Filesystem path to the PKCS#8 PEM private key for BENCHMARK_USER. Operator
# generates the RSA keypair locally with openssl (private key never enters
# terraform state); terraform consumes only the public half via
# snowflake_benchmark_user_rsa_public_key. Consumed by the harness via
# snowflake-connector-python's private_key_file= arg and by Estuary's
# materialize-snowflake credentials block (JWT mode) via the
# BENCHMARK_PRIVATE_KEY computed property.
SNOWFLAKE_BENCHMARK_PRIVATE_KEY_FILE=

# Role granted on the warehouse and database.
SNOWFLAKE_ROLE=BENCHMARK_ROLE

# Database holding TPC-DS/DSB/ClickBench tables and benchmark staging.
SNOWFLAKE_DATABASE=BENCHMARK_DB

# Snowflake region; cost telemetry uses this to resolve credit rates.
SNOWFLAKE_REGION=us-east-1

# Region-specific credit price (USD/credit) for cost attribution.
SNOWFLAKE_CREDIT_RATE_USD=4.0
